# ===== 126 邮箱 IMAP 配置 (测试用)，实际esp32端配置传递 =====
# 126 邮箱地址
IMAP_USER=your_email@126.com
# 126 邮箱 IMAP 授权码（非登录密码）
IMAP_PASS=your_imap_auth_code
# IMAP 服务器
IMAP_HOST=imap.126.com
# IMAP 端口
IMAP_PORT=993
# 126 默认不需要 useSecure（993 即 SSL），保留配置项以便切换
USE_SECURE=true

# ===== 抓取参数 =====
# 12306 购票通知发件人（多个用逗号分隔）
TICKET_SENDERS=12306@rails.com.cn,service@12306.cn
# 抓取最近多少天
FETCH_DAYS=15

# ===== 检票口补全接口 =====
# 当邮件正文中没有"检票口"字段时，回退到该 12306 接口补全
# 可用占位符：{trainCode} {stationName} {date}（调用方负责 URL 编码）
CHECK_POSITION_API=https://mobile.12306.cn/weixin//wxcore/getPlatform?trainCode={trainCode}&stationName={stationName}&date={date}

# ===== 到达时间补全接口 =====
# 12306 到达时间补全 —— 第一步：外部车次（G7178）→ 内部 train_no（5i000G717801）
# 可用占位符：{trainCode} {date}（调用方负责把日期转成 YYYYMMDD 后再填）
TRAIN_SEARCH_API=https://search.12306.cn/search/v1/train/search?keyword={trainCode}&date={date}&type=wx_checi

# 12306 到达时间补全 —— 第二步：train_no + 日期 → 完整经停站列表（含 arrive_time）
# from/to_station_telecode 填 'BBB' 仍会返回完整经停站，省去维护站点电码表
# 可用占位符：{trainNo} {date}（调用方负责把日期转成 YYYY-MM-DD 后再填）
TRAIN_DETAIL_API=https://mobile.12306.cn/weixin/wxcore/queryByTrainNo?train_no={trainNo}&from_station_telecode=BBB&to_station_telecode=BBB&depart_date={date}
